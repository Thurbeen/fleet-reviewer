{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "automerge": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "CI's actions, pinned by SHA with the version in a trailing comment.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "A runtime dependency changes what users install, so it lands as a fix. Dev dependencies, actions and hooks stay chore.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix"
    },
    {
      "description": "npm packages wait longer before an update is proposed.",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "14 days"
    }
  ]
}
